server {
    listen 80;

    server_name localhost;
    root /var/www/html/public;  # Ensure this points to the public folder of your Laravel app

    index index.php index.html index.htm;
    charset utf-8;

    # Allow all Content-Type and Accept headers
    add_header 'Access-Control-Allow-Origin' '*';  # Adjust this as necessary for security
    add_header 'Access-Control-Allow-Headers' '*'; # Allow all headers, including Content-Type and Accept
    add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS'; # Allow specific methods

    # Handle Laravel routes correctly
    location / {
        try_files $uri $uri/ /index.php?$query_string;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Headers' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
            return 204; # No Content
        }
    }

    # Handle common static files
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # PHP-FPM configuration
    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        if (!-f $document_root$fastcgi_script_name) {
            return 404;
        }

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param PATH_TRANSLATED $document_root$fastcgi_path_info;

        fastcgi_read_timeout 300s;
        fastcgi_pass ${BACKEND_URL};
        fastcgi_index index.php;

        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_busy_buffers_size 64k;
        fastcgi_temp_file_write_size 64k;
        fastcgi_keep_conn on;
    }

    # Increase the timeout for upstream requests
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    send_timeout 600s;

    # FastCGI timeout settings (if you're using PHP-FPM)
    fastcgi_connect_timeout 600s;
    fastcgi_send_timeout 600s;
    fastcgi_read_timeout 600s;

    # Connection timeouts
    client_body_timeout 600s;   # Time for client to send the body
    client_header_timeout 600s;  # Time for client to send headers
    keepalive_timeout 600s;     # Keep alive timeout
}
